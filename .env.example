# Copy to .env.local and fill in from the Supabase project settings.
# The anon key is public by design; RLS is the control (spec §8.3).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-side only. Used by the import job (scripts/import). Never exposed
# with a NEXT_PUBLIC_/VITE_ prefix, never committed (spec §8.3).
SUPABASE_SERVICE_ROLE_KEY=
